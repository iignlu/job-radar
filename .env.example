# Copy to .env and fill in. .env is gitignored — never commit real values.

# RapidAPI key with a JSearch subscription.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Bot token from @BotFather on Telegram.
TELEGRAM_TOKEN=

# OPTIONAL. If left blank, the bot derives it from getUpdates on every run —
# you only need to have sent your bot one message. Setting it explicitly is
# more robust (getUpdates only retains ~24h of history), and you can find it
# with:  python -m jobradar --resolve-chat-id
TELEGRAM_CHAT_ID=

# OPTIONAL. The mailbox your LinkedIn job alerts arrive in, read over IMAP.
# Leave either value blank and the LinkedIn source stays off entirely.
#
# On Gmail, IMAP_PASSWORD must be an App Password — never your account
# password: Google Account -> Security -> 2-Step Verification -> App passwords.
# For a non-Gmail mailbox, also set config.IMAP_HOST.
IMAP_USER=
IMAP_PASSWORD=
